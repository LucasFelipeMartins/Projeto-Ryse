# Supabase — Project Settings > API Keys
#
# Chave PUBLICÁVEL: vai para o bundle do navegador. Não protege nada sozinha;
# quem protege é a Row Level Security. Pode ser versionada sem problema.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL pública do app, usada nos links de e-mail (recuperação de senha e
# confirmação de cadastro). Em produção, use o domínio real do deploy.
#
# Atrás de um proxy (Render, Fly, Railway, Docker) esta variável importa mais:
# o processo recebe um host interno e não descobre sozinho o endereço público.
# Deixar aqui um valor de localhost em produção é descartado pelo app, que cai
# nos cabeçalhos X-Forwarded-Host — mas configure mesmo assim. Ver HOSPEDAGEM.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Domínios extras autorizados a disparar Server Actions, separados por vírgula.
# Necessário quando há domínio próprio além do domínio da hospedagem.
# SERVER_ACTIONS_ALLOWED_ORIGINS=ryse.onrender.com,app.ryse.com.br

# ---------------------------------------------------------------------------
# Chave SECRETA (sb_secret_… / service_role). IGNORA a RLS por completo.
#
# NUNCA use o prefixo NEXT_PUBLIC_ nela — isso a mandaria para o navegador.
# Só é necessária para scripts administrativos (scripts/admin.mjs).
# Deixe fora do controle de versão.
# ---------------------------------------------------------------------------
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Análise de documentos de saúde (opcional).
#
# Sem esta chave o upload e todas as validações determinísticas continuam
# funcionando — o documento fica com status "aguardando_analise".
# Implementação em lib/ai/openai.ts.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
#
# Modelos (opcional). O padrão dos dois é gpt-4o-mini, ~US$ 0,002 por
# documento. Para laudos difíceis, vale subir só a análise:
# OPENAI_TRIAGE_MODEL=gpt-4o-mini
# OPENAI_ANALYSIS_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# IA da plataforma (relatórios, dieta, ficha, análise do protocolo).
#
# O SDK da OpenAI fala com qualquer provedor compatível — basta trocar a URL
# base. A primeira chave encontrada vence, nesta ordem:
#
#   AI_API_KEY (+ AI_BASE_URL / AI_MODEL) -> GROQ_API_KEY -> OPENROUTER_API_KEY
#   -> OPENAI_API_KEY
#
# Groq e OpenRouter têm camada gratuita e não pedem cartão. Sem nenhuma chave,
# os botões de IA aparecem desabilitados com aviso — nada quebra.
# ---------------------------------------------------------------------------
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
#
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Provedor arbitrário compatível com a API da OpenAI (inclui Ollama local):
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Notificações push (Web Push / VAPID).
#
# Gere o par de chaves com:
#   npx web-push generate-vapid-keys
#
# A pública vai para o navegador (daí o NEXT_PUBLIC_); a privada assina o
# envio e fica só no servidor. Sem elas, a interface avisa que o envio para o
# celular não está disponível — e o restante do app segue normal.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:contato@seudominio.com

# Segredo do cron que despacha a fila de notificações. Sem ele, a rota
# /api/notificacoes/despachar recusa qualquer chamada.
# CRON_SECRET=troque-por-um-valor-longo-e-aleatorio
